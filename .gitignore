target/
# Cargo.lock is committed for binary crates (required for reproducible Nix builds).
.claude/
# Nix build result symlinks
result
result-*
# Build artifacts (produced by make targets)
*.iso
*.iso.sha256
fake-usb.img
fake-disc-usb.img
fake-shuttle.img
# Nix-built binaries (deploy-dev hot-reload artifact)
*.bin
# cdemu dev session disc images (virtio-9p share from QEMU guest)
dev-disc/
# Editor swap files
*.swp
*.swo
# Core dumps (e.g. from crashed qemu/nix during emulated builds)
core
core.*
vgcore.*
# Compiled example binaries (e.g. yubihsm_enum built for a target)
*.linux
